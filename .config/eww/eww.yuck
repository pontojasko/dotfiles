;; ============================================================
;;  VARS & LISTENERS
;; ============================================================
(defpoll spotify_data :interval "1s" 
  :initial '{"status": "Stopped", "title": "Carregando...", "artist": "", "art": "", "percent": 0, "pos_str": "00:00", "len_str": "00:00", "vol": 0, "icon": "...", "accent_color": "#3c3836", "length": 100}'
  "scripts/spotify.sh get")

(deflisten audio_streams :initial "[]" "bash ./scripts/audio_streams.sh listen")

;; ============================================================
;;  WIDGETS UTILITÁRIOS
;; ============================================================

(defwidget close_overlay [window_name style_class]
  (eventbox :onclick "eww close ${window_name} && hyprctl dispatch submap reset"
            :class "closer-overlay"
            :cursor "default"
    (box :class "${style_class}" :valign "end" :halign "center" (children))))

;; --- NOVO BOTÃO MINIMALISTA ---
(defwidget minimal_close [window_name]
  (button :class "close-btn-minimal"
          :onclick "eww close ${window_name} && hyprctl dispatch submap reset"
          :cursor "pointer"
          "x"))

;; ============================================================
;;  SPOTIFY PLAYER
;; ============================================================

;; ============================================================
;;  SPOTIFY PLAYER
;; ============================================================

(defwindow spotify_control
  :monitor 0
  :geometry (geometry :x "0%" :y "0%" :width "100%" :height "100%" :anchor "center bottom")
  :stacking "overlay"
  :exclusive false
  :focusable false  ;; <--- MUDE ISSO PARA FALSE (Conserta o Hover)
  (close_overlay :window_name "spotify_control" :style_class "layout-box"
    (spotify_widget)))

(defwidget spotify_widget []
  (eventbox :onclick "" 
    (box :class "player-container" :orientation "v" :space-evenly false :width 300
         :style "border: 3px solid ${spotify_data.accent_color ?: '#3c3836'};"

      ;; CAPA
      (eventbox :onclick "hyprctl dispatch workspace 3 && hyprctl dispatch focuswindow class:Spotify" :cursor "pointer"
        (box :class "album-art-container" :style "background-image: url('${spotify_data.art}');" :height 300))

      ;; INFO
      (eventbox :onclick "hyprctl dispatch workspace 3 && hyprctl dispatch focuswindow class:Spotify" :cursor "pointer" :class "music-clickable"
        (box :class "music-info" :orientation "v" :space-evenly false
          (box :width 280 :clip true :halign "center"
            (label :class "song-title marquee" :text "${spotify_data.title}" :limit-width 20))
          (label :class "song-artist" :text "${spotify_data.artist}" :limit-width 30)))

      ;; PROGRESSO
      (box :class "progress-container" :orientation "v" :space-evenly false
        (scale :class "progress-bar" :min 0 :max 100 :value {spotify_data.percent ?: 0} :orientation "h"
               :onchange "playerctl -p spotify position $(awk -v p={} -v l=${spotify_data.length} 'BEGIN {print l * p / 100}')")
        (box :class "time-labels" :orientation "h" :halign "fill"
          (label :halign "start" :text "${spotify_data.pos_str}")
          (label :halign "end"   :text "${spotify_data.len_str}")))

      ;; CONTROLES
      (box :class "controls" :orientation "h" :halign "center" :space-evenly true :spacing 20
        (button :class "control-btn" :onclick "playerctl -p spotify previous" "⏮")
        (button :class "control-btn play-pause" :onclick "playerctl -p spotify play-pause" "${spotify_data.icon}")
        (button :class "control-btn" :onclick "playerctl -p spotify next" "⏭"))

      ;; VOLUME + FECHAR
      ;; valign "center" aqui garante que a barra fique no meio, dando referência para o botão subir
      (box :class "volume-container" :orientation "h" :space-evenly false :spacing 10 :valign "center"
        (label :text "VOL" :style "font-weight: bold; font-size: 10px;")
        (scale :class "volume-bar" :min 0 :max 100 :value {spotify_data.vol ?: 0} :orientation "h"
               :onchange "scripts/spotify.sh vol {}")
        
        ;; Botão X

      )
    )
  )
)

;; ============================================================
;;  AUDIO MIXER
;; ============================================================

(defwindow volume_mixer
  :monitor 0
  :geometry (geometry :x "0%" :y "0%" :width "100%" :height "100%" :anchor "center center")
  :stacking "overlay" :exclusive false :focusable false
  (mixer_closer))

(defwidget mixer_closer []
  (eventbox :onclick "eww close volume_mixer" :class "closer-overlay"
    (box :class "layout-box-mixer" :valign "end" :halign "end"
      (mixer_layout))))

(defwidget mixer_layout []
  (eventbox :onclick "" 
    (box :class "mixer-container" :orientation "v" :space-evenly false :width 350 :style "margin-right: 8px; margin-bottom: 17px;"

      ;; CABEÇALHO COM BOTÃO NA DIREITA
      (box :class "mixer-header" :space-evenly false
        (label :text "mixer" :halign "start" :class "title" :hexpand true) ;; hexpand empurra o botão pro canto
        (minimal_close :window_name "volume_mixer"))

      (box :class "separator" :height 2)

      (scroll :hscroll false :vscroll true 
              :height { arraylength(audio_streams) == 0 ? 50 : ((arraylength(audio_streams) * 60) + 30) > 300 ? 300 : ((arraylength(audio_streams) * 60) + 30) }
        (box :orientation "v" :space-evenly false :class "app-list"
          (revealer :reveal {arraylength(audio_streams) == 0} :transition "slide down"
            (box :class "empty-state" :halign "center" :valign "center" :vexpand true :height 40 (label :text "nothing here")))
          (for entry in audio_streams
            (box :class "app-entry" :orientation "h" :space-evenly false :spacing 10 :height 60
              (label :class "app-icon" :text {entry.icon} :width 40)
              (box :orientation "v" :hexpand true :space-evenly false :valign "center"
                (box :orientation "h" :space-evenly true
                  (label :class "app-name" :text {entry.name} :halign "start" :limit-width 15)
                  (label :class "app-percentage" :text "${entry.volume}%" :halign "end"))
                (scale :class "app-slider" :min 0 :max 101 :value {entry.volume} :onchange "pactl set-sink-input-volume ${entry.id} {}% &")))))))))